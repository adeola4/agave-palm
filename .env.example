# Palm & Agave Nursery — Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL of the deployed site (used for sitemap, canonical URLs, OG images)
PUBLIC_SITE_URL=https://palm-agate-nursery.vercel.app

# Configurable business name (shown in header, footer, SEO)
PUBLIC_BUSINESS_NAME="Palm & Agave Nursery"

# ---------------------------------------------------------------------------
# Supabase (PostgreSQL + Auth + Storage)
# ---------------------------------------------------------------------------
# Project URL from Supabase dashboard → Settings → API
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (client) key — safe to expose to the browser
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-side only, NEVER expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket names
PUBLIC_SUPABASE_BUCKET_PRODUCTS=product-images
PUBLIC_SUPABASE_BUCKET_SPECIMENS=specimen-images

# ---------------------------------------------------------------------------
# Payments — Square
# ---------------------------------------------------------------------------
# Square Application ID (sandbox for development)
SQUARE_APPLICATION_ID=sandbox-sq0idb-...

# Square access token (sandbox for development)
SQUARE_ACCESS_TOKEN=sandbox-sq0atb-...

# Square webhook signature key (for verifying payment webhooks)
SQUARE_WEBHOOK_SIGNATURE_KEY=your-webhook-signature-key

# ---------------------------------------------------------------------------
# Email (transactional)
# ---------------------------------------------------------------------------
# Resend, Sendgrid, or other provider
EMAIL_PROVIDER=resend
EMAIL_API_KEY=your-api-key
EMAIL_FROM="Palm & Agave Nursery <orders@your-domain.com>"

# ---------------------------------------------------------------------------
# Optional: analytics, etc.
# ---------------------------------------------------------------------------
# PUBLIC_ANALYTICS_ID=
