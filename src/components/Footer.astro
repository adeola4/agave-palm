---
// src/components/Footer.astro
const businessName = import.meta.env['PUBLIC_BUSINESS_NAME'] || 'Palm & Agave Nursery';
---

<footer class="site-footer">
  <div class="footer-main container">
    <div class="footer-brand">
      <a href="/" class="footer-brand-link">
        <svg class="footer-brand-mark" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <path d="M16 4C9.373 4 4 9.373 4 16s5.373 12 12 12 12-5.373 12-12S22.627 4 16 4z" fill="currentColor" opacity="0.15"/>
          <path d="M16 12c-2.209 0-4 1.791-4 4s1.791 4 4 4 4-1.791 4-4-1.791-4-4-4z" fill="var(--color-green-deep)"/>
        </svg>
        <span class="footer-brand-name">{businessName}</span>
      </a>
      <p class="footer-tagline">Premium agaves and palm trees for Hillsborough County and the Tampa Bay region.</p>
    </div>

    <div class="footer-links-grid">
      <div class="footer-col">
        <h3 class="footer-col-heading">Shop</h3>
        <ul class="footer-col-list">
          <li><a href="/shop/agaves" class="footer-link">Agave Plants</a></li>
          <li><a href="/shop/palms" class="footer-link">Palm Trees</a></li>
          <li><a href="/shop/agaves?featured=true" class="footer-link">Featured Plants</a></li>
          <li><a href="/cart" class="footer-link">Cart</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-heading">Learn</h3>
        <ul class="footer-col-list">
          <li><a href="/guides" class="footer-link">Plant Guides</a></li>
          <li><a href="/guides/agave-care" class="footer-link">Agave Care</a></li>
          <li><a href="/guides/palm-care" class="footer-link">Palm Care</a></li>
          <li><a href="/guides/hillsborough-plants" class="footer-link">Plants for Hillsborough County</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-heading">Professional</h3>
        <ul class="footer-col-list">
          <li><a href="/wholesale" class="footer-link">Wholesale &amp; Trade</a></li>
          <li><a href="/wholesale/bulk-quote" class="footer-link">Bulk Order Quote</a></li>
          <li><a href="/wholesale/project-inquiry" class="footer-link">Project Inquiry</a></li>
          <li><a href="/delivery" class="footer-link">Delivery &amp; Pickup</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="footer-col-heading">Company</h3>
        <ul class="footer-col-list">
          <li><a href="/about" class="footer-link">About</a></li>
          <li><a href="/contact" class="footer-link">Contact</a></li>
          <li><a href="/faq" class="footer-link">FAQ</a></li>
          <li><a href="/policies" class="footer-link">Policies</a></li>
        </ul>
      </div>
    </div>
  </div>

  <div class="footer-bottom container">
    <p class="footer-bottom-text">
      &copy; {new Date().getFullYear()} {businessName}. All rights reserved.
    </p>
    <div class="footer-bottom-links">
      <a href="/privacy" class="footer-bottom-link">Privacy Policy</a>
      <a href="/terms" class="footer-bottom-link">Terms of Service</a>
      <a href="/accessibility" class="footer-bottom-link">Accessibility</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    background-color: var(--color-charcoal);
    color: rgba(245, 242, 233, 0.8);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .footer-main {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-16);
    }
  }

  @media (min-width: 1024px) {
    .footer-main {
      grid-template-columns: 1fr auto;
      grid-template-rows: auto;
    }
    .footer-links-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-8);
    }
  }

  .footer-brand-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-white);
    margin-bottom: var(--space-4);
  }

  .footer-brand-mark {
    width: 36px;
    height: 36px;
    color: var(--color-sage);
  }

  .footer-brand-name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
  }

  .footer-tagline {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: rgba(245, 242, 233, 0.6);
    max-width: 320px;
  }

  .footer-col-heading {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-sage);
    margin-bottom: var(--space-4);
  }

  .footer-col-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link {
    font-size: var(--text-sm);
    color: rgba(245, 242, 233, 0.75);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover,
  .footer-link:focus-visible {
    color: var(--color-white);
  }

  .footer-bottom {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6) var(--container-padding);
    border-top: 1px solid rgba(245, 242, 233, 0.12);
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-bottom-text {
    font-size: var(--text-xs);
    color: rgba(245, 242, 233, 0.5);
  }

  .footer-bottom-links {
    display: flex;
    gap: var(--space-5);
  }

  .footer-bottom-link {
    font-size: var(--text-xs);
    color: rgba(245, 242, 233, 0.5);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-bottom-link:hover,
  .footer-bottom-link:focus-visible {
    color: rgba(245, 242, 233, 0.8);
  }
</style>
