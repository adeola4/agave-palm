---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const businessName = import.meta.env['PUBLIC_BUSINESS_NAME'] || 'Palm & Agave Nursery';
---

<Layout
  title={`About — ${businessName}`}
  description="About Palm & Agave Nursery — a premium Florida nursery focused on agave plants and palm trees for Hillsborough County and the Tampa Bay region."
>
  <Header cartCount={0} />

  <div class="about-page">
    <section class="about-hero">
      <div class="about-hero-media">
        <img src="https://images.unsplash.com/photo-1567521464027-f127ff144326?w=1400&q=80" alt="Nursery growing area with palms and agaves" width="1400" height="500" loading="eager" class="about-hero-image" />
        <div class="about-hero-overlay" aria-hidden="true"></div>
      </div>
      <div class="about-hero-content container">
        <p class="about-eyebrow">About Us</p>
        <h1 class="about-heading">A nursery built around plants with presence</h1>
        <p class="about-body">
          We are a Florida nursery focused on two product families — agaves and palms — grown for residential landscapes, commercial projects, and professional buyers across Hillsborough County and the wider Tampa Bay region.
        </p>
      </div>
    </section>

    <div class="about-body container">
      <div class="about-grid">
        <section class="about-section">
          <h2 class="about-section-heading">What we do</h2>
          <p>
            We specialize in agave plants and palm trees. That focus shapes everything — how we grow, how we present plants, how we help buyers choose, and how we support projects from a single container purchase to a large landscape installation.
          </p>
          <p>
            Agaves bring architectural structure, clean lines, and long-lived presence. Palms bring vertical form, specimen presence, and the recognizable character of Florida landscapes. We keep both families visible and equally important, because each serves a different role in real landscapes.
          </p>
        </section>

        <section class="about-section">
          <h2 class="about-section-heading">Who we serve</h2>
          <p>
            We work with a range of buyers:
          </p>
          <ul class="about-list">
            <li>Homeowners choosing individual plants for residential landscapes</li>
            <li>Landscape contractors sourcing plants for ongoing projects</li>
            <li>Landscape architects and designers specifying plants for planned work</li>
            <li>Commercial property owners and managers maintaining or developing landscapes</li>
            <li>Developers and builders with project-scale plant needs</li>
            <li>Wholesale and bulk buyers with volume requirements</li>
          </ul>
          <p>
            The site is built to support each of these paths — retail shopping for individual purchases, and wholesale, trade, and bulk quote options for professional buyers.
          </p>
        </section>

        <section class="about-section">
          <h2 class="about-section-heading">Our market</h2>
          <p>
            Our primary market is Hillsborough County, Florida — including Tampa, Brandon, Riverview, Plant City, Valrico, Lutz, Wesley Chapel, and the surrounding county. We also support regional delivery to surrounding counties on request.
          </p>
          <p>
            We are focused on Hillsborough County because it is our core market, not because we believe every plant is right for every site in it. The county has a range of conditions, and the right plant depends on the site, the design, and the buyer's goals.
          </p>
        </section>

        <section class="about-section">
          <h2 class="about-section-heading">How we work</h2>
          <p>
            We try to make the process straightforward. Plants are presented with the information that matters — botanical name, common name, container size, dimensions, sun exposure, cold tolerance, and availability. Buyers can shop retail online or request a quote for bulk or project work.
          </p>
          <p>
            For professional buyers, we review inquiries individually. Trade accounts and wholesale access are approved on application, and pricing is set based on the account and the work it supports. We do not publish fabricated wholesale discounts or minimum orders — if those exist for an account, they are set with the account.
          </p>
        </section>

        <section class="about-section">
          <h2 class="about-section-heading">Plant quality</h2>
          <p>
            We care about presenting plants accurately. Product listings include the information a buyer needs to make a real decision, and we avoid exaggerated claims about size, availability, or suitability.
          </p>
          <p>
            For standard nursery stock, product images are representative unless labeled otherwise. For unique specimen plants, individual identification and photographs are provided where applicable. We do not represent a picture of a plant as the exact specimen being sold unless it actually is that specimen.
          </p>
        </section>

        <section class="about-section about-section--cta">
          <p class="about-cta-text">
            Ready to work with us? Browse the catalog, request a quote, or contact us directly.
          </p>
          <div class="about-cta-links">
            <a href="/shop/agaves" class="btn btn-primary">Shop Agaves</a>
            <a href="/shop/palms" class="btn btn-outline">Shop Palm Trees</a>
            <a href="/wholesale" class="btn btn-outline">Wholesale &amp; Trade</a>
            <a href="/contact" class="btn btn-outline">Contact Us</a>
          </div>
        </section>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .about-page { padding-bottom: var(--space-16); }

  .about-hero { position: relative; padding: var(--space-16) 0; overflow: hidden; }
  .about-hero-media { position: absolute; inset: 0; }
  .about-hero-image { width: 100%; height: 100%; object-fit: cover; object-position: center 30%; }
  .about-hero-overlay { position: absolute; inset: 0; background: linear-gradient(to right, rgba(24,61,44,0.92) 0%, rgba(24,61,44,0.5) 60%, rgba(24,61,44,0.15) 100%); }

  .about-hero-content { position: relative; z-index: 1; max-width: 640px; padding: var(--space-16) 0; }
  @media (max-width: 640px) { .about-hero { padding: var(--space-12) 0; } .about-hero-content { padding: var(--space-12) 0; } }

  .about-eyebrow { font-size: var(--text-xs); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: 0.12em; color: var(--color-sage); margin-bottom: var(--space-3); }
  .about-heading { font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl)); color: var(--color-white); margin-bottom: var(--space-5); line-height: 1.05; }
  .about-body { font-size: var(--text-lg); line-height: 1.65; color: rgba(245,242,233,0.82); max-width: 540px; }

  .about-body { padding-top: var(--space-12); }
  .about-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-10); }

  .about-section { max-width: 680px; }
  .about-section-heading { font-family: var(--font-serif); font-size: var(--text-2xl); color: var(--color-green-deep); margin-bottom: var(--space-5); line-height: 1.15; }
  .about-section p { font-size: var(--text-base); line-height: 1.75; color: var(--color-text-secondary); margin-bottom: var(--space-4); }

  .about-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .about-list li { font-size: var(--text-base); line-height: 1.65; color: var(--color-text-secondary); padding-left: var(--space-5); position: relative; }
  .about-list li::before { content: '—'; position: absolute; left: 0; color: var(--color-sage); }

  .about-section--cta { padding: var(--space-8); background-color: rgba(41,79,59,0.04); border: 1px solid var(--color-border); border-radius: var(--radius-lg); max-width: 100%; }
  .about-cta-text { font-size: var(--text-base); line-height: 1.65; color: var(--color-text-secondary); margin-bottom: var(--space-5); }
  .about-cta-links { display: flex; flex-wrap: wrap; gap: var(--space-3); }
</style>
