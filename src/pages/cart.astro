---
// src/pages/cart.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Dev-mode cart items (replaces with Supabase cart in production)
const cartItems = [
  {
    id: 'v2',
    name: 'Agave victoriae-reginae — Queen Victoria Agave',
    sku: 'AG-VITA-15',
    image: 'https://images.unsplash.com/photo-1511690656952-34342bb7c2f1?w=200&q=60',
    variant: '15 gal container',
    price: 89,
    quantity: 2,
    inventory: 4,
  },
  {
    id: 'v5',
    name: 'Trachycarpus fortunei — Windmill Palm',
    sku: 'PL-TRB-7',
    image: 'https://images.unsplash.com/photo-1583512603805-3cc6b41f3edb?w=200&q=60',
    variant: '7 gal container',
    price: 145,
    quantity: 1,
    inventory: 3,
  },
];

const subtotal = cartItems.reduce((sum, item) => sum + item.price * item.quantity, 0);
const deliveryFee = 75;
const taxRate = 0.06; // Florida 6% — configured from business settings
const tax = subtotal * taxRate;
const total = subtotal + deliveryFee + tax;

const businessName = import.meta.env['PUBLIC_BUSINESS_NAME'] || 'Palm & Agave Nursery';
---

<Layout
  title={`Shopping Cart — ${businessName}`}
  description="Review your plant order, adjust quantities, and continue to checkout. Hillsborough County delivery and nursery pickup available."
>
  <Header cartCount={cartItems.reduce((s, i) => s + i.quantity, 0)} />

  <div class="cart-page">
    <div class="container">
      <header class="cart-header">
        <h1 class="cart-title">Shopping Cart</h1>
        <p class="cart-subtitle">{cartItems.length} item{cartItems.length !== 1 ? 's' : ''} in your cart</p>
      </header>

      {cartItems.length > 0 ? (
        <div class="cart-layout">
          <!-- Cart items -->
          <section class="cart-items-section" aria-labelledby="cart-items-heading">
            <h2 id="cart-items-heading" class="sr-only">Cart items</h2>
            <div class="cart-items">
              {cartItems.map((item) => (
                <div class="cart-item">
                  <a href={`/shop/agaves/${item.sku.slice(-3)}`} class="cart-item-image-link" aria-label={item.name}>
                    <div class="cart-item-image">
                      <img src={item.image} alt="" width="120" height="140" loading="lazy" />
                    </div>
                  </a>
                  <div class="cart-item-body">
                    <a href={`/shop/agaves/${item.sku.slice(-3)}`} class="cart-item-title-link">
                      <h3 class="cart-item-name">{item.name}</h3>
                      <p class="cart-item-sku">SKU: {item.sku}</p>
                    </a>
                    <p class="cart-item-variant">{item.variant}</p>
                    <div class="cart-item-footer">
                      <div class="cart-item-qty">
                        <button class="qty-btn qty-btn--sm" aria-label="Decrease quantity" data-qty-decrease data-item-id={item.id}>−</button>
                        <input
                          type="number"
                          min="1"
                          max={item.inventory}
                          value={item.quantity}
                          class="qty-input qty-input--sm"
                          aria-label={`Quantity of ${item.name}`}
                          data-qty-input data-item-id={item.id}
                        />
                        <button class="qty-btn qty-btn--sm" aria-label="Increase quantity" data-qty-increase data-item-id={item.id}>+</button>
                      </div>
                      <span class="cart-item-price">\${item.price * item.quantity}</span>
                    </div>
                    {item.quantity > item.inventory && (
                      <p class="cart-item-warning">Only {item.inventory} available — quantity reduced to {item.inventory}.</p>
                    )}
                    <p class="cart-item-inventory">{item.inventory > 0 ? `${item.inventory} in stock` : 'Out of stock'}</p>
                  </div>
                  <button class="cart-item-remove" aria-label={`Remove ${item.name} from cart`} data-cart-remove data-item-id={item.id}>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 6 6 18M6 6l12 12"/>
                    </svg>
                  </button>
                </div>
              ))}
            </div>
          </section>

          <!-- Order summary -->
          <aside class="order-summary" aria-labelledby="summary-heading">
            <h2 id="summary-heading" class="summary-title">Order Summary</h2>
            <dl class="summary-lines">
              <div class="summary-line">
                <dt>Subtotal</dt>
                <dd>\${subtotal.toFixed(2)}</dd>
              </div>
              <div class="summary-line summary-line--delivery">
                <dt>
                  <span class="delivery-icon-sm">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14.5 12.5L19 8M5 19l4-4 4 4M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                  </span>
                  Delivery — Hillsborough County
                </dt>
                <dd>\${deliveryFee.toFixed(2)}</dd>
              </div>
              <div class="summary-line summary-line--tax">
                <dt>Florida Sales Tax (6%)</dt>
                <dd>\${tax.toFixed(2)}</dd>
              </div>
              <div class="summary-line summary-line--total">
                <dt>Order Total</dt>
                <dd>\${total.toFixed(2)}</dd>
              </div>
            </dl>

            <div class="summary-fulfillment">
              <div class="fulfillment-row">
                <span class="fulfillment-label">Fulfillment</span>
                <span class="fulfillment-value">
                  <span class="fulfillment-option fulfillment-option--selected" data-fulfillment="delivery">
                    <input type="radio" name="fulfillment" value="delivery" checked class="sr-only" />
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M14.5 12.5L19 8M5 19l4-4 4 4M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    Delivery — Hillsborough County (\${deliveryFee.toFixed(2)})
                  </span>
                  <span class="fulfillment-option" data-fulfillment="pickup">
                    <input type="radio" name="fulfillment" value="pickup" class="sr-only" />
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                    Pickup at Nursery (Free)
                  </span>
                </span>
              </div>
            </div>

            <div class="summary-promo">
              <label class="promo-label" for="promo-code">Promotion Code</label>
              <div class="promo-controls">
                <input
                  id="promo-code"
                  type="text"
                  placeholder="Enter code"
                  class="promo-input"
                  aria-label="Promotion code"
                />
                <button class="btn btn-sm btn-outline" type="button">Apply</button>
              </div>
            </div>

            <a href="/checkout" class="btn btn-primary btn-block btn-lg">
              Proceed to Checkout
            </a>

            <p class="summary-note">
              Orders are reviewed before payment is processed. Large specimens, bulk orders, and out-of-county delivery may require a quote before checkout.
            </p>

            <div class="summary-alternative">
              <p class="alternative-label">Prefer to request a quote?</p>
              <a href="/wholesale/bulk-quote" class="btn btn-outline btn-block">
                Request a Bulk Quote
              </a>
            </div>
          </aside>
        </div>
      ) : (
        <div class="empty-cart">
          <svg class="empty-cart-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
            <path d="M3 6h18"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <h2 class="empty-cart-title">Your cart is empty</h2>
          <p class="empty-cart-body">Browse our agaves and palm trees to start building your plant order.</p>
          <div class="empty-cart-actions">
            <a href="/shop/agaves" class="btn btn-primary">Shop Agaves</a>
            <a href="/shop/palms" class="btn btn-outline">Shop Palm Trees</a>
          </div>
        </div>
      )}
    </div>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Quantity controls
    const qtyInputs = document.querySelectorAll('[data-qty-input]');
    const decreaseBtns = document.querySelectorAll('[data-qty-decrease]');
    const increaseBtns = document.querySelectorAll('[data-qty-increase]');

    decreaseBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.querySelector(`[data-qty-input][data-item-id="${btn.dataset.itemId}"]`);
        if (input) {
          let val = parseInt(input.value, 10) || 1;
          input.value = Math.max(1, val - 1);
        }
      });
    });

    increaseBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const input = document.querySelector(`[data-qty-input][data-item-id="${btn.dataset.itemId}"]`);
        const max = parseInt(input?.max, 10) || 99;
        if (input) {
          let val = parseInt(input.value, 10) || 1;
          input.value = Math.min(max, val + 1);
        }
      });
    });

    // Fulfillment radio toggle (visual only in this version)
    const fulfillmentOptions = document.querySelectorAll('[data-fulfillment]');
    fulfillmentOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        fulfillmentOptions.forEach(o => o.classList.remove('fulfillment-option--selected'));
        opt.classList.add('fulfillment-option--selected');
        const radio = opt.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      });
    });

    // Remove item
    const removeBtns = document.querySelectorAll('[data-cart-remove]');
    removeBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.cart-item');
        if (item) {
          item.style.transition = 'opacity 200ms, transform 200ms';
          item.style.opacity = '0';
          item.style.transform = 'translateX(20px)';
          setTimeout(() => item.remove(), 200);
        }
      });
    });
  });
</script>

<style>
  .cart-page {
    padding: var(--space-10) 0 var(--space-16);
    min-height: 60vh;
  }

  .cart-header {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .cart-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: var(--color-green-deep);
    margin-bottom: var(--space-2);
  }

  .cart-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }

  .cart-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 900px) {
    .cart-layout {
      grid-template-columns: 1fr 380px;
      gap: var(--space-12);
    }
  }

  /* ----- Cart items ----- */
  .cart-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .cart-item {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-5);
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    align-items: center;
    transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .cart-item:hover {
    border-color: var(--color-sage);
    box-shadow: var(--shadow-sm);
  }

  .cart-item-image-link {
    flex-shrink: 0;
  }

  .cart-item-image {
    width: 120px;
    height: 140px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-limestone);
  }

  .cart-item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-item-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cart-item-title-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .cart-item-name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-green-deep);
    line-height: 1.3;
    margin-bottom: var(--space-1);
  }

  .cart-item-sku {
    font-size: var(--text-xs);
    font-family: monospace;
    color: var(--color-text-muted);
    letter-spacing: 0.02em;
  }

  .cart-item-variant {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-1);
  }

  .cart-item-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .cart-item-qty {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .qty-btn--sm {
    width: 32px;
    height: 32px;
    font-size: var(--text-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-secondary);
    background-color: var(--color-surface);
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .qty-btn--sm:hover:not(:disabled) {
    background-color: var(--color-limestone);
    color: var(--color-green-deep);
  }

  .qty-input--sm {
    width: 40px;
    height: 32px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border);
    border-right: 1px solid var(--color-border);
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    -moz-appearance: textfield;
  }

  .qty-input--sm::-webkit-outer-spin-button,
  .qty-input--sm::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-item-price {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-green-deep);
    font-family: var(--font-serif);
  }

  .cart-item-warning {
    font-size: var(--text-xs);
    color: var(--color-warning);
    margin: 0;
  }

  .cart-item-inventory {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin: 0;
  }

  .cart-item-remove {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    border-radius: var(--radius-full);
    transition: color var(--transition-fast), background-color var(--transition-fast);
  }

  .cart-item-remove:hover,
  .cart-item-remove:focus-visible {
    color: var(--color-danger);
    background-color: rgba(179, 66, 50, 0.08);
  }

  .cart-item-remove svg { width: 16px; height: 16px; }

  /* ----- Order summary ----- */
  .order-summary {
    position: sticky;
    top: calc(68px + var(--space-6));
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .summary-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-green-deep);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-2);
  }

  .summary-lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .summary-line {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .summary-line dt { }

  .summary-line dd {
    font-weight: var(--font-medium);
    color: var(--color-text-primary);
    margin: 0;
  }

  .summary-line--delivery {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-top: var(--space-2);
    border-top: 1px solid var(--color-border);
  }

  .summary-line--tax {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .summary-line--total {
    padding-top: var(--space-3);
    border-top: 2px solid var(--color-green-deep);
    margin-top: var(--space-2);
  }

  .summary-line--total dt {
    font-size: var(--text-base);
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .summary-line--total dd {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
    color: var(--color-green-deep);
    font-family: var(--font-serif);
  }

  .delivery-icon-sm {
    width: 14px;
    height: 14px;
    display: inline-block;
    vertical-align: middle;
    margin-right: var(--space-2);
    color: var(--color-green-deep);
  }

  /* ----- Fulfillment selector ----- */
  .summary-fulfillment { }

  .fulfillment-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .fulfillment-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sage);
    margin-bottom: var(--space-2);
  }

  .fulfillment-value {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .fulfillment-option {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .fulfillment-option:hover {
    border-color: var(--color-accent);
  }

  .fulfillment-option--selected {
    border-color: var(--color-green-deep);
    background-color: rgba(41, 79, 59, 0.06);
    color: var(--color-text-primary);
    font-weight: var(--font-medium);
  }

  .fulfillment-option svg {
    width: 18px;
    height: 18px;
    color: var(--color-green-deep);
    flex-shrink: 0;
  }

  /* ----- Promo ----- */
  .summary-promo {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .promo-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sage);
  }

  .promo-controls {
    display: flex;
    gap: var(--space-2);
  }

  .promo-input {
    flex: 1;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    transition: border-color var(--transition-fast);
  }

  .promo-input:focus {
    outline: none;
    border-color: var(--color-accent);
  }

  .promo-input::placeholder { color: var(--color-text-muted); }

  /* ----- Buttons ----- */
  .btn-block {
    display: block;
    width: 100%;
    text-align: center;
  }

  .summary-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.6;
    text-align: center;
  }

  .summary-alternative {
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .alternative-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
    font-weight: var(--font-medium);
  }

  /* ----- Empty cart ----- */
  .empty-cart {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-20) var(--space-8);
    background-color: var(--color-limestone);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .empty-cart-icon {
    width: 64px;
    height: 64px;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .empty-cart-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-green-deep);
    margin-bottom: var(--space-2);
  }

  .empty-cart-body {
    font-size: var(--text-base);
    color: var(--color-text-muted);
    margin-bottom: var(--space-8);
    max-width: 360px;
  }

  .empty-cart-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
