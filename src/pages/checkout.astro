---
// src/pages/checkout.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const businessName = import.meta.env['PUBLIC_BUSINESS_NAME'] || 'Palm & Agave Nursery';

// Dev-mode checkout form (replaces with secure server-side checkout in production)
const deliveryZones = [
  { id: 'hillsborough', name: 'Hillsborough County — Local', baseRate: 75, minOrder: 200, note: 'Flat rate within Hillsborough County.' },
  { id: 'pickup', name: 'Pickup at Nursery', baseRate: 0, minOrder: 0, note: 'Customer picks up at nursery. Appointment preferred for large specimens.' },
  { id: 'pasco', name: 'Regional — Pasco County', baseRate: 125, minOrder: 500, note: 'Pasco County delivery. Minimum order applies.' },
  { id: 'quote', name: 'Quote Required', baseRate: 0, minOrder: 0, note: 'For large specimens, bulk orders, freight, and project deliveries.' },
];

const floridaTaxRate = 0.06;
---

<Layout
  title={`Checkout — ${businessName}`}
  description="Complete your plant order with secure checkout. Hillsborough County delivery, nursery pickup, and regional delivery available."
>
  <Header cartCount={0} />

  <div class="checkout-page">
    <div class="container">
      <header class="checkout-header">
        <h1 class="checkout-title">Checkout</h1>
        <nav class="checkout-steps" aria-label="Checkout progress">
          <ol class="steps-list">
            <li><span class="step step--current">Cart</span></li>
            <li class="step-sep" aria-hidden="true">/</li>
            <li><span class="step step--current">Information</span></li>
            <li class="step-sep" aria-hidden="true">/</li>
            <li><span class="step step--pending">Payment</span></li>
          </ol>
        </nav>
      </header>

      <div class="checkout-layout">
        <!-- Main form -->
        <main class="checkout-main">
          <!-- Contact -->
          <section class="checkout-section" aria-labelledby="contact-heading">
            <h2 id="contact-heading" class="section-heading">Contact Information</h2>
            <form class="checkout-form" novalidate>
              <div class="form-row form-row--2">
                <div class="form-field">
                  <label class="form-label" for="email">Email Address</label>
                  <input
                    id="email"
                    type="email"
                    name="email"
                    class="form-input"
                    placeholder="you@example.com"
                    autocomplete="email"
                    required
                    aria-describedby="email-error"
                  />
                  <p class="form-error" id="email-error" hidden>Please enter a valid email address.</p>
                </div>
                <div class="form-field">
                  <label class="form-label" for="phone">Phone Number <span class="form-optional">(optional)</span></label>
                  <input
                    id="phone"
                    type="tel"
                    name="phone"
                    class="form-input"
                    placeholder="(813) 555-0100"
                    autocomplete="tel"
                    aria-describedby="phone-error"
                  />
                </div>
              </div>

              <h3 class="subsection-heading">Shipping Address</h3>
              <div class="form-row form-row--2">
                <div class="form-field form-field--full">
                  <label class="form-label" for="firstName">First Name</label>
                  <input id="firstName" type="text" class="form-input" autocomplete="given-name" required />
                </div>
                <div class="form-field form-field--full">
                  <label class="form-label" for="lastName">Last Name</label>
                  <input id="lastName" type="text" class="form-input" autocomplete="family-name" required />
                </div>
              </div>
              <div class="form-field form-field--full">
                <label class="form-label" for="address">Street Address</label>
                <input id="address" type="text" class="form-input" autocomplete="street-address" required />
              </div>
              <div class="form-row form-row--3">
                <div class="form-field">
                  <label class="form-label" for="city">City</label>
                  <input id="city" type="text" class="form-input" autocomplete="address-level2" required />
                </div>
                <div class="form-field">
                  <label class="form-label" for="state">State</label>
                  <select id="state" class="form-select" autocomplete="address-level1">
                    <option value="FL">Florida</option>
                  </select>
                </div>
                <div class="form-field">
                  <label class="form-label" for="zip">ZIP Code</label>
                  <input id="zip" type="text" class="form-input" pattern="[0-9]{5}" maxlength="5" autocomplete="postal-code" required />
                </div>
              </div>

              <div class="form-field form-field--full">
                <label class="form-label" for="notes">Order Notes <span class="form-optional">(optional)</span></label>
                <textarea
                  id="notes"
                  name="notes"
                  class="form-textarea"
                  rows="3"
                  placeholder="Delivery instructions, preferred delivery date, or any special requests..."
                ></textarea>
              </div>

              <div class="form-field form-field--full checkbox-field">
                <label class="checkbox-label checkbox-label--large">
                  <input type="checkbox" name="billing-address" class="checkbox-input" />
                  <span>Bill me using the same address</span>
                </label>
              </div>

              <div class="form-field form-field--full checkbox-field">
                <label class="checkbox-label checkbox-label--large">
                  <input type="checkbox" name="marketing" class="checkbox-input" />
                  <span>Send me care tips, new plant arrivals, and exclusive offers.</span>
                </label>
              </div>
            </form>
          </section>

          <hr class="checkout-divider" />

          <!-- Delivery -->
          <section class="checkout-section" aria-labelledby="delivery-heading">
            <h2 id="delivery-heading" class="section-heading">Delivery &amp; Pickup</h2>
            <div class="delivery-options">
              {deliveryZones.map((zone) => (
                <label class={`delivery-option${zone.id === 'hillsborough' ? ' delivery-option--selected' : ''}`}>
                  <input
                    type="radio"
                    name="delivery-zone"
                    value={zone.id}
                    class="delivery-radio"
                    checked={zone.id === 'hillsborough'}
                  />
                  <div class="delivery-option-content">
                    <div class="delivery-option-header">
                      <span class="delivery-option-name">{zone.name}</span>
                      <span class="delivery-option-price">{zone.baseRate === 0 ? 'Free' : `$${zone.baseRate.toFixed(2)}`}</span>
                    </div>
                    <p class="delivery-option-note">{zone.note}{zone.minOrder > 0 ? ` Minimum order: $${zone.minOrder}.` : ''}</p>
                  </div>
                </label>
              ))}
            </div>

            <div class="delivery-info-box">
              <svg class="info-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4M12 16h.01"/>
              </svg>
              <div>
                <strong>Important:</strong> We review every order before processing payment. If your order includes large specimens or requires freight, we will contact you to confirm delivery details and pricing. No payment is taken until your order is confirmed.
              </div>
            </div>
          </section>

          <hr class="checkout-divider" />

          <!-- Payment -->
          <section class="checkout-section" aria-labelledby="payment-heading">
            <h2 id="payment-heading" class="section-heading">Payment</h2>
            <div class="payment-notice">
              <svg class="notice-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <div>
                <strong>Secure checkout.</strong> Payments are processed through Square. Your payment information is encrypted and never stored on our servers.
                <br /><br />
                <span class="notice-note">For development, the payment sandbox is not yet configured. In production, you will be redirected to Square Checkout after submitting your order.</span>
              </div>
            </div>

            <div class="payment-secure-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
              <span>Secure payment powered by Square</span>
            </div>

            <div class="payment-placeholder">
              <svg class="payment-card-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"/>
                <line x1="1" y1="10" x2="23" y2="10"/>
              </svg>
              <p>Payment fields will appear here once Square is configured.</p>
            </div>
          </section>
        </main>

        <!-- Order summary sidebar -->
        <aside class="checkout-sidebar" aria-labelledby="sidebar-heading">
          <h2 id="sidebar-heading" class="sr-only">Order Summary</h2>
          <div class="sidebar-card">
            <h3 class="sidebar-card-title">Order Summary</h3>

            <div class="sidebar-items">
              <div class="sidebar-item">
                <div class="sidebar-item-image">
                  <img src="https://images.unsplash.com/photo-1511690656952-34342bb7c2f1?w=80&q=60" alt="" width="60" height="60" loading="lazy" />
                </div>
                <div class="sidebar-item-body">
                  <p class="sidebar-item-name">Agave victoriae-reginae</p>
                  <p class="sidebar-item-variant">15 gal · Qty 2</p>
                </div>
                <span class="sidebar-item-price">$178.00</span>
              </div>
              <div class="sidebar-item">
                <div class="sidebar-item-image">
                  <img src="https://images.unsplash.com/photo-1583512603805-3cc6b41f3edb?w=80&q=60" alt="" width="60" height="60" loading="lazy" />
                </div>
                <div class="sidebar-item-body">
                  <p class="sidebar-item-name">Trachycarpus fortunei</p>
                  <p class="sidebar-item-variant">7 gal · Qty 1</p>
                </div>
                <span class="sidebar-item-price">$145.00</span>
              </div>
            </div>

            <div class="sidebar-summary">
              <div class="sidebar-summary-row">
                <span>Subtotal</span>
                <span>$323.00</span>
              </div>
              <div class="sidebar-summary-row sidebar-summary-row--delivery">
                <span>Delivery — Hillsborough County</span>
                <span>$75.00</span>
              </div>
              <div class="sidebar-summary-row sidebar-summary-row--tax">
                <span>Florida Tax (6%)</span>
                <span>$19.38</span>
              </div>
              <div class="sidebar-summary-row sidebar-summary-row--total">
                <span>Total</span>
                <span>$417.38</span>
              </div>
            </div>

            <a href="/cart" class="btn btn-outline btn-block">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width:16px;height:16px;">
                <path d="M15 18l-6-6 6-6"/>
              </svg>
              Back to Cart
            </a>

            <button class="btn btn-primary btn-block btn-lg" type="button" data-checkout-submit>
              Continue to Payment
            </button>

            <p class="sidebar-note">
              By placing this order you agree to our Terms of Service and confirm that the delivery address is correct. We will contact you before processing payment if any details need clarification.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Delivery option selection
    const deliveryOptions = document.querySelectorAll('.delivery-option');
    deliveryOptions.forEach(opt => {
      opt.addEventListener('click', () => {
        deliveryOptions.forEach(o => o.classList.remove('delivery-option--selected'));
        opt.classList.add('delivery-option--selected');
        const radio = opt.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      });
    });

    // Form validation helpers
    const emailInput = document.getElementById('email');
    const emailError = document.getElementById('email-error');
    if (emailInput && emailError) {
      emailInput.addEventListener('blur', () => {
        if (!emailInput.value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value)) {
          emailError.hidden = false;
        } else {
          emailError.hidden = true;
        }
      });
    }

    const zipInput = document.getElementById('zip');
    if (zipInput) {
      zipInput.addEventListener('input', () => {
        zipInput.value = zipInput.value.replace(/[^0-9]/g, '').slice(0, 5);
      });
    }

    // Checkout submit (dev-mode only — shows confirmation modal)
    const submitBtn = document.querySelector('[data-checkout-submit]');
    if (submitBtn) {
      submitBtn.addEventListener('click', () => {
        // In production this submits the order and redirects to Square
        const overlay = document.createElement('div');
        overlay.className = 'checkout-modal-overlay';
        overlay.innerHTML = `
          <div class="checkout-modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
            <h2 id="modal-title" class="modal-title">Order Submitted</h2>
            <div class="modal-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <path d="M22 4 12 14.01l-3-3"/>
              </svg>
            </div>
            <p class="modal-body">
              Thank you for your order. We have received your submission and will review it shortly.
              <br /><br />
              <strong>This is a development preview.</strong> In production, you would be redirected to Square Checkout to complete payment.
            </p>
            <p class="modal-email">A confirmation will be sent to your email address once payment is processed.</p>
            <button class="btn btn-primary" type="button" data-modal-close>Continue</button>
          </div>
        `;
        document.body.appendChild(overlay);
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) overlay.remove();
        });
        overlay.querySelector('[data-modal-close]').addEventListener('click', () => overlay.remove());
      });
    }
  });
</script>

<style>
  .checkout-page {
    padding: var(--space-10) 0 var(--space-16);
    min-height: 60vh;
    background-color: var(--color-background);
  }

  .checkout-header {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
  }

  .checkout-title {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    color: var(--color-green-deep);
    margin-bottom: var(--space-5);
  }

  .checkout-steps {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .steps-list {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    list-style: none;
  }

  .step {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-muted);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
  }

  .step--current {
    color: var(--color-green-deep);
    background-color: rgba(41, 79, 59, 0.08);
  }

  .step--pending {
    color: var(--color-text-muted);
  }

  .step-sep {
    color: var(--color-border-strong);
    font-size: var(--text-sm);
  }

  .checkout-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 900px) {
    .checkout-layout {
      grid-template-columns: 1fr 380px;
      gap: var(--space-12);
    }
  }

  /* ----- Sections ----- */
  .checkout-section {
    margin-bottom: var(--space-4);
  }

  .section-heading {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-green-deep);
    margin-bottom: var(--space-5);
  }

  .subsection-heading {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: var(--space-6) 0 var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .checkout-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: var(--space-6) 0;
  }

  /* ----- Form ----- */
  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row {
    display: grid;
    gap: var(--space-4);
  }

  .form-row--2 { grid-template-columns: 1fr; }

  @media (min-width: 640px) {
    .form-row--2 { grid-template-columns: 1fr 1fr; }
  }

  .form-row--3 {
    grid-template-columns: 2fr 1fr 1fr;
  }

  @media (max-width: 640px) {
    .form-row--3 { grid-template-columns: 1fr; }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .form-field--full {
    display: block;
    width: 100%;
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--color-text-secondary);
  }

  .form-optional {
    font-weight: var(--font-normal);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
  }

  .form-input, .form-select, .form-textarea {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    color: var(--color-text-primary);
    background-color: var(--color-surface);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .form-input:focus, .form-select:focus, .form-textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(24, 61, 44, 0.12);
  }

  .form-input::placeholder, .form-textarea::placeholder {
    color: var(--color-text-muted);
  }

  .form-textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-error {
    font-size: var(--text-xs);
    color: var(--color-danger);
    margin: 0;
  }

  .checkbox-field {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .checkbox-label {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  .checkbox-label--large {
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  .checkbox-input {
    accent-color: var(--color-green-deep);
    width: 16px;
    height: 16px;
  }

  /* ----- Delivery options ----- */
  .delivery-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .delivery-option {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .delivery-option:hover {
    border-color: var(--color-accent);
    background-color: rgba(41, 79, 59, 0.03);
  }

  .delivery-option--selected {
    border-color: var(--color-green-deep);
    background-color: rgba(41, 79, 59, 0.06);
  }

  .delivery-radio {
    margin-top: 3px;
    accent-color: var(--color-green-deep);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .delivery-option-content {
    flex: 1;
  }

  .delivery-option-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-1);
  }

  .delivery-option-name {
    font-weight: var(--font-semibold);
    color: var(--color-text-primary);
    font-size: var(--text-base);
  }

  .delivery-option-price {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-green-deep);
    font-family: var(--font-serif);
  }

  .delivery-option-note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }

  .delivery-info-box {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: rgba(41, 79, 59, 0.06);
    border: 1px solid rgba(41, 79, 59, 0.2);
    border-radius: var(--radius-md);
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .info-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-green-deep);
    margin-top: 2px;
  }

  /* ----- Payment ----- */
  .payment-notice {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-4);
    background-color: rgba(166, 124, 58, 0.08);
    border: 1px solid rgba(166, 124, 58, 0.2);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .notice-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-warning);
    margin-top: 2px;
  }

  .notice-note {
    display: block;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-top: var(--space-2);
  }

  .payment-secure-badge {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .payment-secure-badge svg { width: 14px; height: 14px; }

  .payment-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-10);
    background-color: var(--color-limestone);
    border: 2px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .payment-card-icon {
    width: 40px;
    height: 28px;
    color: var(--color-text-muted);
  }

  .payment-placeholder p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ----- Sidebar ----- */
  .checkout-sidebar {
    position: sticky;
    top: calc(68px + var(--space-6));
  }

  .sidebar-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .sidebar-card-title {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-green-deep);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .sidebar-items {
    display: flex;
    flex-direction: column;
