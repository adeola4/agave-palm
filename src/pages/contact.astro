---
// src/pages/contact.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const businessName = import.meta.env['PUBLIC_BUSINESS_NAME'] || 'Palm & Agave Nursery';
---

<Layout
  title={`Contact — ${businessName}`}
  description="Contact Palm & Agave Nursery for plant questions, trade accounts, bulk quotes, and delivery inquiries. Hillsborough County, Florida."
>
  <Header cartCount={0} />

  <div class="contact-page">
    <div class="container">
      <header class="contact-header">
        <h1 class="contact-title">Contact Us</h1>
        <p class="contact-subtitle">Questions about plants, orders, delivery, trade accounts, or bulk quotes.</p>
      </header>

      <div class="contact-grid">
        <div class="contact-info">
          <div class="contact-info-card">
            <h2 class="contact-info-title">Get in touch</h2>
            <p class="contact-info-body">
              For plant questions, order help, delivery inquiries, trade accounts, and bulk quotes, use the form or contact us directly. We review every message and follow up when we can.
            </p>
          </div>

          <div class="contact-details">
            <div class="contact-detail">
              <div class="contact-detail-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <div>
                <p class="contact-detail-label">Service Area</p>
                <p class="contact-detail-value">Hillsborough County, Florida — primary market</p>
                <p class="contact-detail-note">Regional delivery to Pasco, Pinellas, Polk, Manatee, Hernando, and Sarasota counties on request.</p>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-detail-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14.5 12.5L19 8M5 19l4-4 4 4M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="contact-detail-label">Delivery &amp; Pickup</p>
                <p class="contact-detail-value">Local delivery within Hillsborough County and nursery pickup</p>
                <p class="contact-detail-note">Large specimens, field-grown palms, and bulk orders may require a delivery quote.</p>
              </div>
            </div>

            <div class="contact-detail">
              <div class="contact-detail-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="4"/>
                  <path d="M20 21a8 8 0 1 0-16 0"/>
                </svg>
              </div>
              <div>
                <p class="contact-detail-label">Trade &amp; Wholesale</p>
                <p class="contact-detail-value">Trade accounts and wholesale inquiries reviewed on application</p>
                <p class="contact-detail-note">Submit a bulk quote request or trade account application, and we will follow up.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="contact-form-card">
          <h2 class="contact-form-title">Send us a message</h2>
          <form class="contact-form" novalidate>
            <div class="form-row form-row--2">
              <div class="form-field">
                <label class="form-label" for="contact-name">Full Name <span class="form-required">*</span></label>
                <input id="contact-name" type="text" class="form-input" placeholder="Your name" required />
              </div>
              <div class="form-field">
                <label class="form-label" for="contact-email">Email Address <span class="form-required">*</span></label>
                <input id="contact-email" type="email" class="form-input" placeholder="you@example.com" required />
              </div>
            </div>

            <div class="form-field">
              <label class="form-label" for="contact-subject">Subject <span class="form-required">*</span></label>
              <select id="contact-subject" class="form-select" required>
                <option value="">Choose a topic...</option>
                <option value="plant-question">Plant question</option>
                <option value="order-help">Order help</option>
                <option value="delivery">Delivery or pickup inquiry</option>
                <option value="trade">Trade account</option>
                <option value="bulk">Bulk quote request</option>
                <option value="project">Project inquiry</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-field">
              <label class="form-label" for="contact-company">Company / Business <span class="form-optional">(optional)</span></label>
              <input id="contact-company" type="text" class="form-input" placeholder="Your company or business name, if applicable" />
            </div>

            <div class="form-field">
              <label class="form-label" for="contact-message">Message <span class="form-required">*</span></label>
              <textarea id="contact-message" class="form-textarea" rows="5" placeholder="Tell us what you need help with. Include the plants, sizes, quantities, or project details where relevant." required></textarea>
            </div>

            <div class="form-field checkbox-field">
              <label class="checkbox-label checkbox-label--large">
                <input type="checkbox" name="contact-consent" class="checkbox-input" required />
                <span>
                  I understand this form sends a message for response, not an order. I agree to be contacted about my inquiry.
                </span>
              </label>
            </div>

            <button type="submit" class="btn btn-primary btn-lg btn-block">Send Message</button>

            <p class="contact-form-note">
              We review messages and follow up directly. For straightforward questions we may respond quickly. For bulk quotes and trade accounts, we may need more details before responding fully.
            </p>
          </form>
        </div>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.querySelector('.contact-form');
    if (!form) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const required = form.querySelectorAll('[required]');
      let firstInvalid = null;

      required.forEach(field => {
        field.style.borderColor = '';
        if (!field.value || (field.type === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(field.value))) {
          field.style.borderColor = 'var(--color-danger)';
          if (!firstInvalid) firstInvalid = field;
        }
      });

      const consent = form.querySelector('[name="contact-consent"]');
      if (!consent?.checked) {
        consent.closest('.checkbox-field').style.borderColor = 'var(--color-danger)';
        if (!firstInvalid) firstInvalid = consent.closest('.checkbox-field');
      }

      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const btn = form.querySelector('button[type="submit"]');
      const orig = btn.textContent;
      btn.textContent = 'Message Sent';
      btn.disabled = true;

      setTimeout(() => {
        btn.textContent = '✓ Message Sent';
        btn.classList.add('btn-success');
        setTimeout(() => {
          btn.textContent = orig;
          btn.disabled = false;
          btn.classList.remove('btn-success');
          form.reset();
          form.querySelectorAll('[style*="border-color"]').forEach(el => el.style.borderColor = '');
        }, 2500);
      }, 500);
    });
  });
</script>

<style>
  .contact-page { padding: var(--space-10) 0 var(--space-16); }
  .contact-header { margin-bottom: var(--space-10); padding-bottom: var(--space-6); border-bottom: 1px solid var(--color-border); }
  .contact-title { font-family: var(--font-serif); font-size: var(--text-3xl); color: var(--color-green-deep); margin-bottom: var(--space-2); }
  .contact-subtitle { font-size: var(--text-base); color: var(--color-text-muted); }

  .contact-grid { display: grid; grid-template-columns: 1fr; gap: var(--space-10); align-items: start; }
  @media (min-width: 900px) { .contact-grid { grid-template-columns: 1fr 1fr; gap: var(--space-12); } }

  .contact-info { display: flex; flex-direction: column; gap: var(--space-5); }
  .contact-info-card { padding: var(--space-5); background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .contact-info-title { font-family: var(--font-serif); font-size: var(--text-xl); color: var(--color-green-deep); margin-bottom: var(--space-3); }
  .contact-info-body { font-size: var(--text-sm); line-height: 1.65; color: var(--color-text-secondary); }

  .contact-details { display: flex; flex-direction: column; gap: var(--space-4); }
  .contact-detail { display: flex; gap: var(--space-4); padding: var(--space-4); background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); align-items: flex-start; }
  .contact-detail-icon { width: 36px; height: 36px; border-radius: var(--radius-md); background-color: rgba(41,79,59,0.1); color: var(--color-green-deep); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .contact-detail-icon svg { width: 18px; height: 18px; }
  .contact-detail-label { font-size: var(--text-xs); font-weight: var(--font-semibold); text-transform: uppercase; letter-spacing: 0.08em; color: var(--color-sage); margin-bottom: var(--space-1); }
  .contact-detail-value { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-text-primary); margin-bottom: 2px; }
  .contact-detail-note { font-size: var(--text-xs); color: var(--color-text-muted); line-height: 1.5; margin: 0; }

  .contact-form-card { padding: var(--space-6); background-color: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  .contact-form-title { font-family: var(--font-serif); font-size: var(--text-xl); color: var(--color-green-deep); margin-bottom: var(--space-5); }

  .contact-form { display: flex; flex-direction: column; gap: var(--space-4); }
  .form-field { display: flex; flex-direction: column; gap: var(--space-2); }
  .form-row { display: grid; gap: var(--space-4); }
  .form-row--2 { grid-template-columns: 1fr; }
  @media (min-width: 640px) { .form-row--2 { grid-template-columns: 1fr 1fr; } }
  .form-label { font-size: var(--text-sm); font-weight: var(--font-medium); color: var(--color-text-secondary); }
  .form-optional { font-weight: var(--font-normal); color: var(--color-text-muted); font-size: var(--text-xs); }
  .form-required { color: var(--color-danger); font-weight: var(--font-semibold); font-size: var(--text-xs); margin-left: var(--space-1); }
  .form-input, .form-select, .form-textarea { padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border-strong); border-radius: var(--radius-sm); font-size: var(--text-base); color: var(--color-text-primary); background-color: var(--color-surface); transition: border-color var(--transition-fast), box-shadow var(--transition-fast); }
  .form-input:focus, .form-select:focus, .form-textarea:focus { outline: none; border-color: var(--color-accent); box-shadow: 0 0 0 3px rgba(24,61,44,0.12); }
  .form-input::placeholder, .form-textarea::placeholder { color: var(--color-text-muted); }
  .form-textarea { resize: vertical; min-height: 100px; }

  .checkbox-field { padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
  .checkbox-label { display: flex; align-items: flex-start; gap: var(--space-3); font-size: var(--text-sm); color: var(--color-text-secondary); cursor: pointer; line-height: 1.5; }
  .checkbox-label--large { font-size: var(--text-base); color: var(--color-text-primary); }
  .checkbox-input { accent-color: var(--color-green-deep); width: 16px; height: 16px; margin-top: 2px; flex-shrink: 0; }

  .btn-success { background-color: var(--color-success); color: var(--color-white); }
  .btn-block { display: block; width: 100%; text-align: center; }
  .contact-form-note { font-size: var(--text-xs); color: var(--color-text-muted); text-align: center; line-height: 1.6; margin: 0; }
  .btn:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
</style>
