---
// src/pages/guides/index.astro
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const businessName = import.meta.env['PUBLIC_BUSINESS_NAME'] || 'Palm & Agave Nursery';
---

<Layout
  title={`Plant Guides — ${businessName}`}
  description="Practical plant guides for agave and palm selection, care, sizing, and Florida landscape application. Hillsborough County and Tampa Bay."
>
  <Header cartCount={0} />

  <div class="guides-page">
    <section class="guides-hero">
      <div class="guides-hero-media">
        <img
          src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1400&q=80"
          alt="Agave and palm landscape composition"
          width="1400"
          height="450"
          loading="eager"
          class="guides-hero-image"
        />
        <div class="guides-hero-overlay" aria-hidden="true"></div>
      </div>
      <div class="guides-hero-content container">
        <p class="guides-eyebrow">Plant Guides</p>
        <h1 class="guides-heading">Learn before you plant</h1>
        <p class="guides-body">
          Practical guidance on agave selection, palm sizing and measurements, Florida growing conditions, and landscape applications. Written for the plants and the region we serve.
        </p>
      </div>
    </section>

    <div class="guides-body container">
      <div class="guides-grid">
        <a href="/guides/agave-care" class="guide-card">
          <div class="guide-image">
            <img src="https://images.unsplash.com/photo-1511690656952-34342bb7c2f1?w=700&q=80" alt="Agave rosette" width="700" height="400" loading="lazy" />
          </div>
          <div class="guide-body">
            <p class="guide-eyebrow">Agave Care</p>
            <h2 class="guide-title">Agave selection and care for Florida landscapes</h2>
            <p class="guide-excerpt">
              How to choose the right agave for your space, read size and rosette measurements, understand sun exposure and drainage, and what to expect as agaves establish in Hillsborough County conditions.
            </p>
            <span class="guide-link">Read Guide &rarr;</span>
          </div>
        </a>

        <a href="/guides/palm-care" class="guide-card">
          <div class="guide-image">
            <img src="https://images.unsplash.com/photo-1583512603805-3cc6b41f3edb?w=700&q=80" alt="Palm tree crown" width="700" height="400" loading="lazy" />
          </div>
          <div class="guide-body">
            <p class="guide-eyebrow">Palm Care</p>
            <h2 class="guide-title">Understanding palm height, clear trunk, and mature size</h2>
            <p class="guide-excerpt">
              How palm measurements work, the difference between overall height and clear-trunk height, what to expect as palms grow, and how to select palms for different Florida landscape situations.
            </p>
            <span class="guide-link">Read Guide &rarr;</span>
          </div>
        </a>

        <a href="/guides/hillsborough-plants" class="guide-card">
          <div class="guide-image">
            <img src="https://images.unsplash.com/photo-1567521464027-f127ff144326?w=700&q=80" alt="Florida landscape with palms" width="700" height="400" loading="lazy" />
          </div>
          <div class="guide-body">
            <p class="guide-eyebrow">Local Guide</p>
            <h2 class="guide-title">Plants for Hillsborough County landscapes</h2>
            <p class="guide-excerpt">
              Selection guidance for residential and commercial properties across Tampa, Brandon, Riverview, Plant City, Valrico, Lutz, and Wesley Chapel — including sun exposure, cold tolerance, and delivery considerations.
            </p>
            <span class="guide-link">Read Guide &rarr;</span>
          </div>
        </a>

        <a href="/guides/landscape-design" class="guide-card">
          <div class="guide-image">
            <img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=700&q=80" alt="Landscape design composition" width="700" height="400" loading="lazy" />
          </div>
          <div class="guide-body">
            <p class="guide-eyebrow">Landscape Design</p>
            <h2 class="guide-title">Using agaves and palms together in Florida landscapes</h2>
            <p class="guide-excerpt">
              How to combine architectural agaves and vertical palms in contemporary, tropical, and minimal landscape designs — with guidance on spacing, scale, and plant combinations that work in Florida conditions.
            </p>
            <span class="guide-link">Read Guide &rarr;</span>
          </div>
        </a>

        <a href="/guides/container-growing" class="guide-card">
          <div class="guide-image">
            <img src="https://images.unsplash.com/photo-1459411552884-84c709774d2f?w=700&q=80" alt="Agave in a container" width="700" height="400" loading="lazy" />
          </div>
          <div class="guide-body">
            <p class="guide-eyebrow">Container Growing</p>
            <h2 class="guide-title">Growing agaves and palms in containers</h2>
            <p class="guide-excerpt">
              Container size selection, soil and drainage requirements, watering frequency, and how to keep container-grown agaves and palms healthy in Florida heat — for patios, entrances, and movable landscape features.
            </p>
            <span class="guide-link">Read Guide &rarr;</span>
          </div>
        </a>

        <a href="/guides/cold-tolerance" class="guide-card">
          <div class="guide-image">
            <img src="https://images.unsplash.com/photo-1583512603805-3cc6b41f3edb?w=700&q=80" alt="Palm tree in winter light" width="700" height="400" loading="lazy" />
          </div>
          <div class="guide-body">
            <p class="guide-eyebrow">Cold &amp; Climate</p>
            <h2 class="guide-title">Cold tolerance and winter care for Florida palms and agaves</h2>
            <p class="guide-excerpt">
              What cold tolerance ratings mean, how to protect plants during cold snaps, which species handle Hillsborough County winters best, and what to do after a freeze event.
            </p>
            <span class="guide-link">Read Guide &rarr;</span>
          </div>
        </a>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<style>
  .guides-page {
    padding-bottom: var(--space-16);
  }

  .guides-hero {
    position: relative;
    padding: var(--space-16) 0;
    overflow: hidden;
  }

  .guides-hero-media {
    position: absolute;
    inset: 0;
  }

  .guides-hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .guides-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      rgba(24, 61, 44, 0.92) 0%,
      rgba(24, 61, 44, 0.5) 60%,
      rgba(24, 61, 44, 0.15) 100%
    );
  }

  .guides-hero-content {
    position: relative;
    z-index: 1;
    max-width: 640px;
    padding: var(--space-16) 0;
  }

  @media (max-width: 640px) {
    .guides-hero { padding: var(--space-12) 0; }
    .guides-hero-content { padding: var(--space-12) 0; }
  }

  .guides-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-sage);
    margin-bottom: var(--space-3);
  }

  .guides-heading {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    color: var(--color-white);
    margin-bottom: var(--space-5);
    line-height: 1.05;
  }

  .guides-body {
    font-size: var(--text-lg);
    line-height: 1.65;
    color: rgba(245, 242, 233, 0.82);
    max-width: 520px;
  }

  .guides-body {
    padding-top: var(--space-12);
  }

  .guides-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .guides-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 1024px) {
    .guides-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .guide-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow var(--transition-base), transform var(--transition-base), border-color var(--transition-base);
  }

  .guide-card:hover,
  .guide-card:focus-visible {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    border-color: var(--color-sage);
  }

  .guide-image {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-limestone);
  }

  .guide-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .guide-card:hover .guide-image img,
  .guide-card:focus-visible .guide-image img {
    transform: scale(1.04);
  }

  .guide-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .guide-eyebrow {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sage);
  }

  .guide-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-green-deep);
    line-height: 1.3;
    margin: 0;
  }

  .guide-excerpt {
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--color-text-secondary);
    flex: 1;
  }

  .guide-link {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-green-deep);
    margin-top: var(--space-2);
  }
</style>
