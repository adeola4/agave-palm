---
// src/pages/shop/agaves/[slug].astro
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';

interface Props {
  product: {
    id: string;
    sku: string;
    botanicalName: string;
    commonName: string | null;
    cultivar: string | null;
    category: string;
    image: string;
    price: number;
    containerSize: string;
    rosetteDiameter: string;
    plantHeight: string;
    sunExposure: string;
    waterRequirements: string;
    soilDrainage: string;
    coldTolerance: string;
    growthRate: string;
    spineCharacteristics: string;
    marginalTeeth: string;
    variegation: string;
    offsetsPropagation: string;
    landscapeApplications: string;
    description: string;
    plantingCare: string;
    deliveryNotes: string;
    seoTitle: string;
    seoDescription: string;
    featured: boolean;
    status: string;
    relatedProducts: Array<{ id: string; botanicalName: string; commonName: string | null; image: string; price: number; containerSize: string }>;
  };
}

const { product } = Astro.props;

// Fallback if slug doesn't match any product — render 404
if (!product) {
  return Astro.redirect('/404');
}

// Variants for this product (in production from DB)
const variants = [
  { id: 'v1', name: '10 gal container', sku: `${product.sku}-10`, price: product.price * 0.7, inventory: 4, containerSize: '10 gal', rosetteDiameter: '10 in', plantHeight: '6 in', isAvailable: true },
  { id: 'v2', name: '15 gal container', sku: `${product.sku}-15`, price: product.price, inventory: 2, containerSize: '15 gal', rosetteDiameter: product.rosetteDiameter, plantHeight: product.plantHeight, isAvailable: product.status === 'active' },
  { id: 'v3', name: 'Specimens — quote', sku: `${product.sku}-SPEC`, price: 0, inventory: 0, containerSize: 'Specimen', rosetteDiameter: '24+ in', plantHeight: '18+ in', isAvailable: false, requiresQuote: true },
];

const leafShape = product.spineCharacteristics.includes('smooth') ? 'Smooth, fleshy, succulent leaves' : 'Firm, succulent leaves with marginal teeth';

const selectedVariant = variants.find(v => v.isAvailable) ?? variants[0];

const businessName = import.meta.env['PUBLIC_BUSINESS_NAME'] || 'Palm & Agave Nursery';
---

<Layout
  title={product.seoTitle ?? `${product.botanicalName} — ${businessName}`}
  description={product.seoDescription ?? `${product.botanicalName}${product.commonName ? ` — ${product.commonName}` : ''} — ${product.containerSize} container, ${product.rosetteDiameter} rosette. Available at ${businessName} in Hillsborough County, Florida.`}
  image={product.image}
>
  <Header cartCount={0} />

  <div class="product-page">
    <!-- Breadcrumb -->
    <nav class="breadcrumb container" aria-label="Breadcrumb">
      <ol class="breadcrumb-list">
        <li><a href="/" class="breadcrumb-link">Home</a></li>
        <li aria-hidden="true" class="breadcrumb-sep">/</li>
        <li><a href="/shop/agaves" class="breadcrumb-link">Agaves</a></li>
        <li aria-hidden="true" class="breadcrumb-sep">/</li>
        <li class="breadcrumb-current" aria-current="page">{product.botanicalName}</li>
      </ol>
    </nav>

    <!-- Product hero -->
    <div class="product-hero container">
      <div class="product-gallery">
        <div class="gallery-main">
          <img
            src={product.image}
            alt={`${product.botanicalName}${product.commonName ? ` — ${product.commonName}` : ''} — ${product.containerSize} container`}
            width="900"
            height="1000"
            loading="eager"
            class="gallery-main-image"
          />
        </div>
        <div class="gallery-thumbs">
          <button class="gallery-thumb gallery-thumb--active" aria-label="Main image" data-gallery-thumb>
            <img src={product.image} alt="" width="80" height="100" loading="lazy" />
          </button>
          <button class="gallery-thumb" aria-label="Alternate view" data-gallery-thumb>
            <img src="https://images.unsplash.com/photo-1459411552884-84c709774d2f?w=200&q=60" alt="" width="80" height="100" loading="lazy" />
          </button>
          <button class="gallery-thumb" aria-label="Growth habit view" data-gallery-thumb>
            <img src="https://images.unsplash.com/photo-1506183922908-2e57e7f61cf3?w=200&q=60" alt="" width="80" height="100" loading="lazy" />
          </button>
        </div>
      </div>

      <div class="product-details">
        <div class="product-header">
          <p class="product-category-label">{product.category}</p>
          <h1 class="product-title">{product.botanicalName}</h1>
          {product.commonName && <p class="product-common-name">{product.commonName}</p>}
          {product.cultivar && <p class="product-cultivar">Cultivar: {product.cultivar}</p>}

          <div class="product-sku-box">
            <span class="sku-label">SKU</span>
            <span class="sku-value">{product.sku}</span>
          </div>
        </div>

        <div class="variant-selector">
          <p class="variant-label">Select Size</p>
          <div class="variant-options" role="radiogroup" aria-label="Select plant size">
            {variants.map((v) => (
              <label class={`variant-option${selectedVariant.id === v.id ? ' variant-option--selected' : ''}`}>
                <input
                  type="radio"
                  name="variant"
                  value={v.id}
                  class="variant-radio"
                  checked={v.id === selectedVariant.id}
                  disabled={!v.isAvailable && !v.requiresQuote}
                  aria-describedby={`variant-${v.id}-note`}
                />
                <div class="variant-control">
                  <span class="variant-name">{v.name}</span>
                  <span class="variant-info">{v.containerSize} · {v.rosetteDiameter} rosette · {v.plantHeight} tall</span>
                  {v.isAvailable ? (
                    <span class="variant-price">\${v.price}</span>
                  ) : v.requiresQuote ? (
                    <span class="variant-price variant-price--quote">Quote Required</span>
                  ) : (
                    <span class="variant-price variant-price--unavailable">Unavailable</span>
                  )}
                  {v.inventory > 0 && v.inventory < 5 && (
                    <span class="variant-stock">Only {v.inventory} left</span>
                  )}
                  {!v.isAvailable && v.requiresQuote && (
                    <p id={`variant-${v.id}-note`} class="variant-note">
                      Large specimens are sold individually. Submit a quote request and we will confirm availability and pricing.
                    </p>
                  )}
                </div>
              </label>
            ))}
          </div>
        </div>

        <div class="purchase-box">
          {selectedVariant.isAvailable ? (
            <>
              <div class="price-row">
                <span class="price-label">Price</span>
                <span class="price-value">\${selectedVariant.price}</span>
                <span class="price-per">per plant</span>
              </div>
              <div class="quantity-row">
                <label class="quantity-label" for="quantity">Quantity</label>
                <div class="quantity-control">
                  <button type="button" class="qty-btn" aria-label="Decrease quantity" data-qty-decrease>−</button>
                  <input
                    id="quantity"
                    type="number"
                    min="1"
                    max={selectedVariant.inventory < 99 ? selectedVariant.inventory : 99}
                    value="1"
                    class="qty-input"
                    aria-label="Plant quantity"
                    disabled={selectedVariant.inventory === 0}
                  />
                  <button type="button" class="qty-btn" aria-label="Increase quantity" data-qty-increase>+</button>
                </div>
              </div>
              {selectedVariant.inventory > 0 && selectedVariant.inventory < 99 && (
                <p class="stock-notice">Only <strong>{selectedVariant.inventory}</strong> available — reserve yours now.</p>
              )}
              <div class="delivery-note">
                <svg class="delivery-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M14.5 12.5L19 8M5 19l4-4 4 4M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <span>Delivery within Hillsborough County or pickup at nursery. Large specimens require a delivery quote.</span>
              </div>
              <div class="purchase-actions">
                <a href="/cart" class="btn btn-primary btn-lg">Add to Cart</a>
                <a href="/wholesale/bulk-quote" class="btn btn-outline btn-lg">Quote for Bulk</a>
              </div>
              <p class="trust-note">Secure checkout · Local delivery available · We verify every plant</p>
            </>
          ) : selectedVariant.requiresQuote ? (
            <>
              <div class="price-row">
                <span class="price-label">Price</span>
                <span class="price-value price-value--quote">Quote Required</span>
              </div>
              <p class="quote-notice">
                This specimen requires a custom quote. Tell us about your project, and we will confirm availability and pricing.
              </p>
              <a href="/wholesale/bulk-quote" class="btn btn-primary btn-lg">Request Quote</a>
            </>
          ) : (
            <div class="unavailable-box">
              <svg class="unavailable-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/>
                <path d="M12 8v4M12 16h.01"/>
              </svg>
              <p class="unavailable-text">This size is currently unavailable. Contact us to be notified when it's back in stock.</p>
              <a href="/contact" class="btn btn-outline">Contact Us</a>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Plant specifications -->
    <section class="specs-section" aria-labelledby="specs-heading">
      <div class="container">
        <h2 id="specs-heading" class="specs-heading">Plant Specifications</h2>

        <div class="specs-grid">
          <div class="specs-card">
            <h3 class="specs-card-title">Identity</h3>
            <dl class="specs-list">
              <div class="spec-row">
                <dt>Botanical Name</dt>
                <dd>{product.botanicalName}</dd>
              </div>
              {product.commonName && (
                <div class="spec-row">
                  <dt>Common Name</dt>
                  <dd>{product.commonName}</dd>
                </div>
              )}
              {product.cultivar && (
                <div class="spec-row">
                  <dt>Cultivar</dt>
                  <dd>{product.cultivar}</dd>
                </div>
              )}
              <div class="spec-row">
                <dt>SKU</dt>
                <dd>{product.sku}</dd>
              </div>
              <div class="spec-row">
                <dt>Container Size</dt>
                <dd>{selectedVariant.containerSize}</dd>
              </div>
            </dl>
          </div>

          <div class="specs-card">
            <h3 class="specs-card-title">Size</h3>
            <dl class="specs-list">
              <div class="spec-row">
                <dt>Rosette Diameter</dt>
                <dd>{selectedVariant.rosetteDiameter}</dd>
              </div>
              <div class="spec-row">
                <dt>Plant Height</dt>
                <dd>{selectedVariant.plantHeight}</dd>
              </div>
            </dl>
          </div>

          <div class="specs-card">
            <h3 class="specs-card-title">Growing Conditions</h3>
            <dl class="specs-list">
              <div class="spec-row">
                <dt>Sun Exposure</dt>
                <dd>{product.sunExposure}</dd>
              </div>
              <div class="spec-row">
                <dt>Water Requirements</dt>
                <dd>{product.waterRequirements}</dd>
              </div>
              <div class="spec-row">
                <dt>Soil &amp; Drainage</dt>
                <dd>{product.soilDrainage}</dd>
              </div>
              <div class="spec-row">
                <dt>Cold Tolerance</dt>
                <dd>{product.coldTolerance}</dd>
              </div>
              <div class="spec-row">
                <dt>Growth Rate</dt>
                <dd>{product.growthRate}</dd>
              </div>
            </dl>
          </div>

          <div class="specs-card">
            <h3 class="specs-card-title">Leaf Characteristics</h3>
            <dl class="specs-list">
              <div class="spec-row">
                <dt>Leaf Shape</dt>
                <dd class="spec-value">{leafShape}</dd>
              </div>
              <div class="spec-row">
                <dt>Spine Characteristics</dt>
                <dd>{product.spineCharacteristics}</dd>
              </div>
              <div class="spec-row">
                <dt>Marginal Teeth</dt>
                <dd>{product.marginalTeeth}</dd>
              </div>
              <div class="spec-row">
                <dt>Variegation</dt>
                <dd>{product.variegation}</dd>
              </div>
              <div class="spec-row">
                <dt>Offsets &amp; Propagation</dt>
                <dd>{product.offsetsPropagation}</dd>
              </div>
            </dl>
          </div>

          <div class="specs-card">
            <h3 class="specs-card-title">Landscape Use</h3>
            <dl class="specs-list">
              <div class="spec-row">
                <dt>Landscape Applications</dt>
                <dd>{product.landscapeApplications}</dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </section>

    <!-- Description & care -->
    <section class="description-section">
      <div class="container">
        <div class="description-grid description-grid--2">
          <div class="description-card">
            <h2 class="description-heading">About This Plant</h2>
            <p class="description-body">{product.description}</p>
          </div>
          <div class="description-card">
            <h2 class="description-heading">Planting &amp; Care</h2>
            <p class="description-body">{product.plantingCare}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Delivery & handling -->
    <section class="delivery-section">
      <div class="container">
        <div class="delivery-grid">
          <div class="delivery-card">
            <div class="delivery-icon-wrap">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14.5 12.5L19 8M5 19l4-4 4 4M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h3 class="delivery-title">Delivery &amp; Pickup</h3>
              <p class="delivery-body">{product.deliveryNotes}</p>
            </div>
          </div>
          <div class="delivery-card">
            <div class="delivery-icon-wrap delivery-icon-wrap--warning">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 9v2m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
              </svg>
            </div>
            <div>
              <h3 class="delivery-title">Important Notes</h3>
              <p class="delivery-body">
                Agaves contain fibrous leaves and sharp terminal spines. Wear gloves and eye protection when handling large specimens. Keep away from walkways and play areas.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Related products -->
    {product.relatedProducts?.length > 0 && (
      <section class="related-section" aria-labelledby="related-heading">
        <div class="container">
          <h2 id="related-heading" class="related-heading">You May Also Like</h2>
          <div class="related-grid">
            {product.relatedProducts.map((rp) => (
              <a href={`/shop/agaves/${rp.id}`} class="related-card">
                <div class="related-image">
                  <img src={rp.image} alt={`${rp.botanicalName} — ${rp.commonName ?? ''}`} width="400" height="400" loading="lazy" />
                </div>
                <div class="related-info">
                  <h3 class="related-name">{rp.botanicalName}</h3>
                  {rp.commonName && <p class="related-common">{rp.commonName}</p>}
                  <p class="related-size">{rp.containerSize} · \${rp.price}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </div>

  <Footer />
</Layout>

<script>
  // Gallery thumbnail switching and quantity controls
  document.addEventListener('DOMContentLoaded', () => {
    // Gallery
    const thumbs = document.querySelectorAll('[data-gallery-thumb]');
    const mainImage = document.querySelector('.gallery-main-image');
    if (thumbs.length && mainImage) {
      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          thumbs.forEach(t => t.classList.remove('gallery-thumb--active'));
          thumb.classList.add('gallery-thumb--active');
          const img = thumb.querySelector('img');
          if (img) mainImage.src = img.src.replace('w=200', 'w=900').replace('q=60', 'q=80');
        });
      });
    }

    // Quantity controls
    const qtyInput = document.querySelector('#quantity');
    const decrease = document.querySelector('[data-qty-decrease]');
    const increase = document.querySelector('[data-qty-increase]');
    if (qtyInput && decrease && increase) {
      const update = () => {
        let val = parseInt(qtyInput.value, 10) || 1;
        const max = parseInt(qtyInput.max, 10) || 99;
        if (val < 1) qtyInput.value = 1;
        if (val > max) qtyInput.value = max;
      };
      decrease.addEventListener('click', () => { qtyInput.value = Math.max(1, parseInt(qtyInput.value, 10) - 1); });
      increase.addEventListener('click', () => { qtyInput.value = Math.min(parseInt(qtyInput.max, 10) || 99, parseInt(qtyInput.value, 10) + 1); });
    }
  });
</script>

<style>
  .product-page {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  /* ----- Breadcrumb ----- */
  .breadcrumb {
    padding-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }

  .breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .breadcrumb-link {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .breadcrumb-link:hover,
  .breadcrumb-link:focus-visible {
    color: var(--color-accent);
  }

  .breadcrumb-sep { color: var(--color-border-strong); }

  .breadcrumb-current {
    color: var(--color-text-primary);
    font-weight: var(--font-medium);
  }

  /* ----- Product hero ----- */
  .product-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 900px) {
    .product-hero {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }

  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .gallery-main {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-limestone);
    box-shadow: var(--shadow-md);
  }

  .gallery-main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-thumbs {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .gallery-thumb {
    width: 80px;
    height: 100px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 2px solid var(--color-border-strong);
    background-color: var(--color-surface);
    transition: border-color var(--transition-fast), opacity var(--transition-fast);
    opacity: 0.55;
  }

  .gallery-thumb:hover,
  .gallery-thumb:focus-visible {
    opacity: 1;
  }

  .gallery-thumb--active {
    border-color: var(--color-accent);
    opacity: 1;
  }

  .gallery-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-details {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .product-header { }

  .product-category-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-sage);
    margin-bottom: var(--space-3);
  }

  .product-title {
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    color: var(--color-green-deep);
    margin-bottom: var(--space-2);
    line-height: 1.1;
  }

  .product-common-name {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .product-cultivar {
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
  }

  .product-sku-box {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-limestone);
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
  }

  .sku-label {
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .sku-value {
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    color: var(--color-text-secondary);
    font-family: monospace;
  }

  /* ----- Variant selector ----- */
  .variant-selector {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    background-color: var(--color-surface);
  }

  .variant-label {
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-sage);
    margin-bottom: var(--space-3);
  }

  .variant-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .variant-option {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
    position: relative;
  }

  .variant-option:hover {
    border-color: var(--color-accent);
    background-color: rgba(41, 79, 59, 0.03);
  }

  .variant-option--selected {
    border-color: var(--color-green-deep);
    background-color: rgba(41, 79, 59, 0.06);
  }

  .variant-radio {
    margin-top: 3px;
    accent-color: var(--color-green-deep);
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .variant-control {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    flex: 1;
  }

  .variant-name {
    font-weight: var(--font-semibold);
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  .variant-info {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .variant-price {
    font-size: var(--text-lg);
    font-weight: var(--font-bold);
    color: var(--color-green-deep);
    font-family: var(--font-serif);
  }

  .variant-price--quote {
    color: var(--color-text-muted);
    font-family: var(--font-sans);
    font-weight: var(--font-medium);
  }

