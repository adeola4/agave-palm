    id: '4',
    sku: 'AG-MAN-10',
    botanicalName: 'Agave manzanilla',
    commonName: 'Manzanilla Agave',
    cultivar: null,
    category: 'Compact Agaves',
    image: 'https://images.unsplash.com/photo-1459411552884-84c709774d2f?w=800&q=80',
    price: 49,
    containerSize: '10 gal',
    rosetteDiameter: '9 in',
    plantHeight: '5 in',
    sunExposure: 'Full sun to partial shade',
    coldTolerance: '20°F (−6°C)',
    variegation: 'No',
    spineCharacteristics: 'No spines',
    status: 'active',
    slug: 'agave-manzanilla',
  },
  {
    id: '5',
    sku: 'AG-OCE-15',
    botanicalName: 'Agave ocahui',
    commonName: 'Ocahui Agave',
    cultivar: null,
    category: 'Landscape Agaves',
